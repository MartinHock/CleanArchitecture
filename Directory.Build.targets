<Project>
  <PropertyGroup Condition="'$(AnalyzerProfile)' != ''">
    <_AnalyzerProfileConfig>$(IntermediateOutputPath)analyzer-profile.globalconfig</_AnalyzerProfileConfig>
  </PropertyGroup>
  <ItemGroup Condition="'$(AnalyzerProfile)' != ''">
    <EditorConfigFiles Include="$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(_AnalyzerProfileConfig)'))" />
  </ItemGroup>
  <Target Name="GenerateAnalyzerProfileConfig" BeforeTargets="CoreCompile" Condition="'$(AnalyzerProfile)' != '' and '$(IsCrossTargetingBuild)' != 'true'">
    <Exec Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)analyzer-profiles/Generator/Generator.csproj&quot; -- generate &quot;$(MSBuildThisFileDirectory)analyzer-profiles/matrix.json&quot; &quot;$(AnalyzerProfile)&quot; &quot;$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(_AnalyzerProfileConfig)'))&quot;" />
  </Target>
</Project>
