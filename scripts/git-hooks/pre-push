#!/bin/sh
# Opt-in only: git config --local core.hooksPath scripts/git-hooks
# Do not treat this local check as a substitute for hosted CI.
if [ "${LOCAL_CI_FORCE_FAIL:-0}" = "1" ]; then
  echo "Local CI BLOCK: forced failure for hook verification" >&2
  exit 1
fi
root=$(git rev-parse --show-toplevel) || exit 1
if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoProfile -File "$root/scripts/local-ci/pre-push.ps1" -RepositoryRoot "$root"
fi
if command -v powershell.exe >/dev/null 2>&1; then
  exec powershell.exe -NoProfile -File "$root/scripts/local-ci/pre-push.ps1" -RepositoryRoot "$root"
fi
echo "Local CI BLOCK: PowerShell (pwsh or powershell.exe) not found" >&2
exit 1
